# Copy this to .env.local and fill in any one of the integrations below.
# The form will keep working even with none of these set — it just won't send emails.

# ── Option 1: Resend (recommended for transactional email) ──
# Sign up at resend.com → API Keys
# RESEND_API_KEY=re_xxxxxxxxxxxx

# ── Option 2: ConvertKit / Kit ──
# Get from convertkit.com → Account → Advanced
# KIT_API_KEY=
# KIT_FORM_ID=

# ── Option 3: Generic webhook (Zapier, Make, n8n, your backend) ──
# Easiest: paste a Zapier webhook URL or your own endpoint.
# Receives the full lead JSON as POST.
# LEAD_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxxxx/yyyyyyy/
